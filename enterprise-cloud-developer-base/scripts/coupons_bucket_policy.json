{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyDeleteWithoutMFA",
      "Effect": "Deny",
      "Principal": "*",
      "Action": [
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:DeleteBucket"
      ],
      "Resource": [
        "arn:aws:s3:::coupons",
        "arn:aws:s3:::coupons/*"
      ],
      "Condition": {
        "Null": {
          "aws:MultiFactorAuthPresent": "true"
        }
      }
    }
  ]
}
